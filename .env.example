# KeyForge — example environment configuration
# Copy this file to ".env" and fill in your real values. Never commit the real .env.
#
# The app runs with ZERO configuration — without any of the values below it uses a
# simulated demo checkout and records emails to the database (log mode) instead of
# sending them. Fill in the Email section to send real mail.

# ─── Email (Gmail SMTP — recommended, free, delivers to any address) ──
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
#    (a normal Gmail password will be REJECTED — you need the 16-char App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=*** HERE

# Display name + address shown to recipients
EMAIL_FROM=KeyForge <you@gmail.com>

# Where admin notifications (new orders, registrations, reviews) are sent
ADMIN_EMAIL=you@example.com

# ─── Email (Resend — alternative to Gmail SMTP) ───────────────────
# If RESEND_API_KEY is set it takes priority over SMTP.
# Get an API key at https://resend.com (API Keys → Create API Key, starts with "re_")
# Note: Resend's free test sender only delivers to your own account email until you
# verify a domain. Gmail SMTP (above) has no such restriction.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ─── Server ───────────────────────────────────────────────────────
# Server port (default 4000)
PORT=4000

# Secret used to sign JWT auth tokens — set a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# ─── Client URL (used in verification / reset email links) ────────
APP_URL=http://localhost:5173

# ─── Payment: Khalti (Nepali wallet — sandbox is free) ────────────
# Get a sandbox secret key at https://test-admin.khalti.com (API Keys section).
# Sandbox API base: https://dev.khalti.com/api/v2  (the default below).
# Test payment: wallet 9800000000 / MPIN 1111 / OTP 987654
# KHALTI_BASE_URL=https://dev.khalti.com/api/v2
# KHALTI_SECRET_KEY=*** HERE

# ─── Optional: Stripe (leave unset to use simulated demo checkout) ─
# Get test keys at https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx